{
  "name": "paperclip-mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A TypeScript MCP server for operating PaperclipAI as a board assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "paperclip-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "paperclip",
    "mcp",
    "model-context-protocol",
    "copilot",
    "board-assistant"
  ],
  "packageManager": "npm@11.6.2",
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "lint:commits:last": "commitlint --last --verbose",
    "format": "biome format --write .",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:unreleased": "git-cliff --unreleased --strip header",
    "release:notes:current": "git-cliff --current --strip header",
    "ci": "npm run check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
